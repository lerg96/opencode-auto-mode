{
  "name": "@lerg96/opencode-auto-mode",
  "version": "1.0.2",
  "description": "OpenCode plugin for LLM-based automatic command approval with 3-tier safety, secret guard, and inline script analysis",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "auto-mode.jsonc.example",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc --emitDeclarationOnly",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/",
    "test:pbt": "jest tests/property-based/",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lerg96/opencode-auto-mode.git"
  },
  "homepage": "https://github.com/lerg96/opencode-auto-mode#readme",
  "bugs": {
    "url": "https://github.com/lerg96/opencode-auto-mode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "security",
    "auto-mode",
    "llm",
    "automation"
  ],
  "author": "Luis Romero <lerg96@gmail.com> (https://github.com/lerg96)",
  "license": "MIT",
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "fast-check": "^3.23.2",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
